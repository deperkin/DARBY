    "MaxVerses": 8,
    "verses": [
      {
        "Vnumber": 1,
        "count": 16083,
        "text": "{A Song of degrees.} I lift up mine eyes unto the mountains: whence shall my help come?",
        "WordCount": 17,
        "StartsParagraph": true
      },
      {
        "Vnumber": 2,
        "count": 16084,
        "text": "My help [cometh] from Jehovah, who made the heavens and the earth.",
        "WordCount": 12,
        "StartsParagraph": false
      },
      {
        "Vnumber": 3,
        "count": 16085,
        "text": "He will not suffer thy foot to be moved; he that keepeth thee will not slumber.",
        "WordCount": 16,
        "StartsParagraph": false
      },
      {
        "Vnumber": 4,
        "count": 16086,
        "text": "Behold, he that keepeth Israel will neither slumber nor sleep.",
        "WordCount": 10,
        "StartsParagraph": false
      },
      {
        "Vnumber": 5,
        "count": 16087,
        "text": "Jehovah is thy keeper, Jehovah is thy shade upon thy right hand;",
        "WordCount": 12,
        "StartsParagraph": false
      },
      {
        "Vnumber": 6,
        "count": 16088,
        "text": "The sun shall not smite thee by day, nor the moon by night.",
        "WordCount": 13,
        "StartsParagraph": false
      },
      {
        "Vnumber": 7,
        "count": 16089,
        "text": "Jehovah will keep thee from all evil; he will keep thy soul.",
        "WordCount": 12,
        "StartsParagraph": false
      },
      {
        "Vnumber": 8,
        "count": 16090,
        "text": "Jehovah will keep thy going out and thy coming in, from henceforth and for evermore.",
        "WordCount": 15,
        "StartsParagraph": false
      }
    ]
  }
}
